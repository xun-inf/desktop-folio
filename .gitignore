# 构建产物
build/
frontend/dist/
frontend/node_modules/
node_modules/

# 可选的本地 FlatBuffers 覆盖（默认由 CMake 下载到 build/）
core/thirdparty/flatc/
core/thirdparty/flatbuffers/
# rcedit 工具（scripts/build.py 自动下载，不入库）
core/thirdparty/rcedit/

# 运行期产物
logs/
*.log

# Python 缓存（scripts/build.py 会被 run.py import）
__pycache__/
*.pyc

# 编辑器 / 工具
.vs/
.vscode/
*.user

tests/

# Electron build manifests
!frontend/package.json
!frontend/package-lock.json
